<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hmi="clr-namespace:Scada.App.Controls.Hmi" xmlns:model="clr-namespace:Scada.App.Hmi">
<model:FaceplateTemplateSelector x:Key="FaceplateTemplateSelector"/>
<DataTemplate x:Key="MotorFaceplateTemplate"><StackPanel><TextBlock Text="Motor" FontWeight="Bold"/><TextBlock Text="{Binding DisplayName}"/><TextBlock Text="{Binding StateText}"/></StackPanel></DataTemplate>
<DataTemplate x:Key="PumpFaceplateTemplate"><StackPanel><TextBlock Text="Pump" FontWeight="Bold"/><TextBlock Text="{Binding DisplayName}"/><TextBlock Text="{Binding StateText}"/></StackPanel></DataTemplate>
<DataTemplate x:Key="ValveFaceplateTemplate"><StackPanel><TextBlock Text="Valve" FontWeight="Bold"/><TextBlock Text="{Binding DisplayName}"/><TextBlock Text="{Binding StateText}"/></StackPanel></DataTemplate>
<DataTemplate x:Key="AnalogFaceplateTemplate"><StackPanel><TextBlock Text="Equipment" FontWeight="Bold"/><TextBlock Text="{Binding DisplayName}"/><TextBlock Text="{Binding DisplayValue}"/><TextBlock Text="{Binding DisplayQuality}"/><TextBlock Text="{Binding DisplayTimestamp}"/></StackPanel></DataTemplate>
<Style TargetType="{x:Type hmi:FaceplateHost}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type hmi:FaceplateHost}"><Border Background="#CC162536" Padding="24"><Border Background="White" Width="360" Padding="20"><ContentPresenter Content="{Binding Context,RelativeSource={RelativeSource TemplatedParent}}" ContentTemplateSelector="{StaticResource FaceplateTemplateSelector}"/></Border></Border></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
