<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hmi="clr-namespace:Scada.App.Controls.Hmi" xmlns:model="clr-namespace:Scada.App.Hmi">
 <model:HmiStateBrushConverter x:Key="HmiStateBrushConverter"/>
 <model:HmiFractionToLengthConverter x:Key="HmiFractionToLengthConverter"/>
 <Style x:Key="Base" TargetType="Control"><Setter Property="Width" Value="76"/><Setter Property="Height" Value="76"/><Setter Property="ToolTip" Value="{Binding Context.StateText,RelativeSource={RelativeSource Self}}"/></Style>
 <Style TargetType="{x:Type hmi:MotorControl}" BasedOn="{StaticResource Base}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type hmi:MotorControl}"><Border Background="{Binding Context.State,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource HmiStateBrushConverter}}" BorderBrush="Black" BorderThickness="2" CornerRadius="38" AutomationProperties.Name="Motor state"><Grid><Ellipse Fill="White" Margin="16"/><TextBlock Text="M" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/><TextBlock Text="{Binding Context.StateText,RelativeSource={RelativeSource TemplatedParent}}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom"/></Grid></Border></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="{x:Type hmi:PumpControl}" BasedOn="{StaticResource Base}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type hmi:PumpControl}"><Border Background="{Binding Context.State,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource HmiStateBrushConverter}}" BorderBrush="Black" BorderThickness="2" CornerRadius="8" AutomationProperties.Name="Pump state"><Grid><Ellipse Fill="White" Margin="14"/><TextBlock Text="P" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/><TextBlock Text="{Binding Context.StateText,RelativeSource={RelativeSource TemplatedParent}}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom"/></Grid></Border></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="{x:Type hmi:ValveControl}" BasedOn="{StaticResource Base}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type hmi:ValveControl}"><Grid AutomationProperties.Name="Valve position"><Polygon Points="8,38 38,8 68,38 38,68" Fill="{Binding Context.State,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource HmiStateBrushConverter}}" Stroke="Black" StrokeThickness="2"/><TextBlock Text="{Binding Context.StateText,RelativeSource={RelativeSource TemplatedParent}}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="{x:Type hmi:TankControl}" BasedOn="{StaticResource Base}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type hmi:TankControl}"><Border BorderBrush="Black" BorderThickness="2" AutomationProperties.Name="Tank level"><Grid><Rectangle Fill="{Binding Context.State,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource HmiStateBrushConverter}}" Height="{Binding Context.TankFillFraction,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource HmiFractionToLengthConverter},ConverterParameter=52}" VerticalAlignment="Bottom"/><TextBlock Text="{Binding Context.DisplayValue,RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding Context.StateText,RelativeSource={RelativeSource TemplatedParent}}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom"/></Grid></Border></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="{x:Type hmi:PipeControl}" BasedOn="{StaticResource Base}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type hmi:PipeControl}"><Grid AutomationProperties.Name="Pipe flow"><Rectangle Height="22" Fill="{Binding Context.State,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource HmiStateBrushConverter}}" Stroke="Black"/><TextBlock Text="FLOW" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/><TextBlock Text="{Binding Context.StateText,RelativeSource={RelativeSource TemplatedParent}}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="{x:Type hmi:ConveyorControl}" BasedOn="{StaticResource Base}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type hmi:ConveyorControl}"><Grid AutomationProperties.Name="Conveyor state"><Rectangle Height="28" Fill="{Binding Context.State,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource HmiStateBrushConverter}}" Stroke="Black"/><TextBlock Text="≋ ≋ ≋" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="{Binding Context.StateText,RelativeSource={RelativeSource TemplatedParent}}" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Bottom"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="{x:Type hmi:IndicatorControl}" BasedOn="{StaticResource Base}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type hmi:IndicatorControl}"><Border Background="{Binding Context.State,RelativeSource={RelativeSource TemplatedParent},Converter={StaticResource HmiStateBrushConverter}}" BorderBrush="Black" BorderThickness="2" CornerRadius="38" AutomationProperties.Name="Indicator value"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Context.DisplayValue,RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Center" FontWeight="Bold"/><TextBlock Text="{Binding Context.StateText,RelativeSource={RelativeSource TemplatedParent}}" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Border></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
