<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hmi="clr-namespace:Scada.App.Controls.Hmi">
 <Style TargetType="{x:Type hmi:HmiControlBase}"><Setter Property="Width" Value="64"/><Setter Property="Height" Value="64"/><Setter Property="ToolTip" Value="{Binding Context.StateText, RelativeSource={RelativeSource Self}}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type hmi:HmiControlBase}"><Border BorderThickness="2" BorderBrush="{StaticResource HmiUnknownBrush}" Background="{StaticResource CardBrush}" CornerRadius="4" AutomationProperties.Name="{Binding Context.StateText, RelativeSource={RelativeSource TemplatedParent}}"><Grid><Ellipse Fill="{StaticResource HmiUnknownBrush}" Width="18" Height="18"/><TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"/></Grid></Border></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="{x:Type hmi:MotorControl}" BasedOn="{StaticResource {x:Type hmi:HmiControlBase}}"/><Style TargetType="{x:Type hmi:PumpControl}" BasedOn="{StaticResource {x:Type hmi:HmiControlBase}}"/><Style TargetType="{x:Type hmi:ValveControl}" BasedOn="{StaticResource {x:Type hmi:HmiControlBase}}"/><Style TargetType="{x:Type hmi:TankControl}" BasedOn="{StaticResource {x:Type hmi:HmiControlBase}}"/><Style TargetType="{x:Type hmi:PipeControl}" BasedOn="{StaticResource {x:Type hmi:HmiControlBase}}"/><Style TargetType="{x:Type hmi:ConveyorControl}" BasedOn="{StaticResource {x:Type hmi:HmiControlBase}}"/><Style TargetType="{x:Type hmi:IndicatorControl}" BasedOn="{StaticResource {x:Type hmi:HmiControlBase}}"/>
</ResourceDictionary>
