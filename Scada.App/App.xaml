<Application x:Class="Scada.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Controls.xaml" />
                <ResourceDictionary Source="Resources/Hmi/HmiColors.xaml" />
                <ResourceDictionary Source="Resources/Hmi/HmiControls.xaml" />
                <ResourceDictionary Source="Resources/Hmi/HmiFaceplates.xaml" />
                <ResourceDictionary Source="Resources/MachineSettings/ParameterEditors.xaml" />
                <ResourceDictionary Source="Resources/Alarms.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
