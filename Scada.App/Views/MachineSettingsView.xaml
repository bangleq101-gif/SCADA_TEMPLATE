<UserControl x:Class="Scada.App.Views.MachineSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Scada.App.Controls">
    <controls:WorkspaceLayout Title="Machine Settings"
                              Description="Machine-specific settings workspace."
                              Style="{StaticResource WorkspaceLayoutStyle}">
        <Border Style="{StaticResource CardBorderStyle}">
            <TextBlock Text="Machine settings" Style="{StaticResource CardTitleTextStyle}" />
        </Border>
    </controls:WorkspaceLayout>
</UserControl>
