<UserControl x:Class="Scada.App.Views.EngineeringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Scada.App.Controls">
    <controls:WorkspaceLayout Title="Engineering"
                              Description="Engineering configuration workspace."
                              Style="{StaticResource WorkspaceLayoutStyle}">
        <Border Style="{StaticResource CardBorderStyle}">
            <TextBlock Text="Engineering workspace" Style="{StaticResource CardTitleTextStyle}" />
        </Border>
    </controls:WorkspaceLayout>
</UserControl>
