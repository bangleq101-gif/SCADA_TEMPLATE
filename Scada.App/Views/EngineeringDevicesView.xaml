<UserControl x:Class="Scada.App.Views.EngineeringDevicesView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Scada.App.Controls">
    <controls:WorkspaceLayout Title="Engineering Devices"
                              Description="Configure static device definitions and browse vendor-neutral address candidates. Changes require restart."
                              Style="{DynamicResource WorkspaceLayoutStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                <Button Content="Add" Command="{Binding AddCommand}" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,6,0" />
                <Button Content="Duplicate" Command="{Binding DuplicateCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,6,0" />
                <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,6,0" />
                <Button Content="Revert" Command="{Binding RevertCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,6,0" />
                <Button Content="Save" Command="{Binding SaveCommand}" Style="{DynamicResource PrimaryButtonStyle}" />
            </WrapPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="8">
                    <DataGrid ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                              Style="{DynamicResource WorkspaceDataGridStyle}"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              AutomationProperties.Name="Configured devices">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="42" />
                            <DataGridTextColumn Header="Id" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Driver" Binding="{Binding DriverType}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedDevice}">
                        <Border Style="{DynamicResource CardBorderStyle}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Device Id" Style="{DynamicResource FieldLabelTextStyle}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Device Id" Margin="4" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" Style="{DynamicResource FieldLabelTextStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Device name" Margin="4" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Driver" Style="{DynamicResource FieldLabelTextStyle}" />
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding DataContext.DriverTypes, ElementName=Root}" SelectedItem="{Binding DriverType, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Driver type" Margin="4" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Enabled" Style="{DynamicResource FieldLabelTextStyle}" />
                                <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Device enabled" Margin="4" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Options" Style="{DynamicResource FieldLabelTextStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ConnectionSummary}" TextWrapping="Wrap" Margin="4" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Grid>
                        </Border>
                        <Border Style="{DynamicResource CardBorderStyle}" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Driver options" Style="{DynamicResource CardTitleTextStyle}" Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding DataContext.DriverOptionEditors, ElementName=Root}"
                                          SelectedItem="{Binding DataContext.SelectedOption, ElementName=Root}"
                                          Style="{DynamicResource WorkspaceDataGridStyle}"
                                          CanUserAddRows="False"
                                          AutomationProperties.Name="Driver options">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Option" Binding="{Binding DisplayName}" IsReadOnly="True" Width="180" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource CardBorderStyle}" Padding="12" Margin="0,10,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0">
                                    <TextBlock Text="Address Browser" Style="{DynamicResource CardTitleTextStyle}" />
                                    <Button DockPanel.Dock="Right" Content="Browse" Command="{Binding DataContext.BrowseAddressesCommand, ElementName=Root}" Style="{DynamicResource SecondaryButtonStyle}" AutomationProperties.Name="Browse addresses" />
                                </DockPanel>
                                <TextBlock Grid.Row="1" Text="Read-only provider candidates; selecting a row never reads or writes the PLC." Style="{DynamicResource FieldLabelTextStyle}" TextWrapping="Wrap" />
                                <ListBox Grid.Row="2" ItemsSource="{Binding DataContext.AddressCandidates, ElementName=Root}" SelectedItem="{Binding DataContext.SelectedCandidate, ElementName=Root}" AutomationProperties.Name="Address candidates" MinHeight="100">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Address}" Width="90" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DataType}" Width="90" />
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding RestartRequired, StringFormat=Restart required: {0}}" Foreground="{DynamicResource WarningBrush}" Margin="12,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding IsDirty, StringFormat=Dirty: {0}}" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ValidationSummary}" Foreground="{DynamicResource BadBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </DockPanel>
        </Grid>
    </controls:WorkspaceLayout>
</UserControl>
