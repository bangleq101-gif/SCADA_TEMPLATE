<UserControl x:Class="Scada.App.Views.OperationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Scada.App.Controls">
    <controls:WorkspaceLayout Title="Operation"
                              Description="Overview of the configured SCADA runtime and project."
                              Style="{StaticResource WorkspaceLayoutStyle}">
        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Runtime summary" Style="{StaticResource CardTitleTextStyle}" />
                <TextBlock Text="{Binding RuntimeSummary}"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>
    </controls:WorkspaceLayout>
</UserControl>
