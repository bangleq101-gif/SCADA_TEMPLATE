<UserControl x:Class="Scada.App.Views.EngineeringDiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Scada.App.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Scada.App;component/Resources/Colors.xaml" />
                <ResourceDictionary Source="/Scada.App;component/Resources/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <controls:WorkspaceLayout Title="Engineering Diagnostics"
                              Description="Read-only device and service diagnostics."
                              Style="{StaticResource WorkspaceLayoutStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding RuntimeDetail}" AutomationProperties.Name="Runtime diagnostic summary" />
            <TextBlock Grid.Row="1" Text="{Binding ProcessDetail}" Margin="0,6,0,10" Foreground="{StaticResource SecondaryTextBrush}" />
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Devices}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      AutomationProperties.Name="Device diagnostics table">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Device" Binding="{Binding DeviceId}" />
                    <DataGridTextColumn Header="State" Binding="{Binding State}" />
                    <DataGridTextColumn Header="Connection" Binding="{Binding ConnectionState}" />
                    <DataGridTextColumn Header="Last success" Binding="{Binding LastSuccessfulRead}" />
                    <DataGridTextColumn Header="Last failure" Binding="{Binding LastFailureAt}" />
                    <DataGridTextColumn Header="Reads" Binding="{Binding ReadCount}" />
                    <DataGridTextColumn Header="Failures" Binding="{Binding FailureCount}" />
                    <DataGridTextColumn Header="Scan" Binding="{Binding LastScanDuration}" />
                    <DataGridTextColumn Header="Missed" Binding="{Binding MissedCycleCount}" />
                    <DataGridTextColumn Header="Error" Binding="{Binding LastError}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </controls:WorkspaceLayout>
</UserControl>
