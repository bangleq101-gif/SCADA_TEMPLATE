<UserControl x:Class="Scada.App.Views.MqttSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Margin="24"><TextBlock Text="MQTT Settings" Style="{StaticResource WorkspaceTitleTextStyle}"/>
    <CheckBox Content="Enable MQTT publisher" IsChecked="{Binding Enabled}"/><TextBox Text="{Binding Host,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding Port,UpdateSourceTrigger=PropertyChanged}"/>
    <TextBox Text="{Binding BaseTopic,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding TopicTemplate,UpdateSourceTrigger=PropertyChanged}"/>
    <TextBox Text="{Binding Username,UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding PasswordReference,UpdateSourceTrigger=PropertyChanged}" ToolTip="env:VARIABLE only"/><CheckBox Content="Use TLS" IsChecked="{Binding UseTls}"/>
    <StackPanel Orientation="Horizontal"><Button Content="Save" Command="{Binding SaveCommand}"/><Button Content="Revert" Command="{Binding RevertCommand}"/><Button Content="Test Connection" Command="{Binding TestConnectionCommand}"/></StackPanel>
    <TextBlock Text="{Binding TestConnectionStatus}"/>
    <TextBlock Text="{Binding RuntimeStatus.State}"/></StackPanel></ScrollViewer>
</UserControl>
