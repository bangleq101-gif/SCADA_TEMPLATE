<Window x:Class="Scada.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Scada.App.ViewModels"
        xmlns:views="clr-namespace:Scada.App.Views"
        Title="SCADA TEMPLATE" Height="720" Width="1200" MinHeight="520" MinWidth="900">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OperationViewModel}"><views:OperationView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MachineSettingsViewModel}"><views:MachineSettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonitoringViewModel}"><views:MonitoringView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:EngineeringViewModel}"><views:EngineeringView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TagManagerViewModel}"><views:TagManagerView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistorySettingsViewModel}"><views:HistorySettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MqttSettingsViewModel}"><views:MqttSettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlarmMonitoringViewModel}"><views:AlarmMonitoringView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlarmEngineeringViewModel}"><views:AlarmEngineeringView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemServicesViewModel}"><views:SystemServicesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:EngineeringDiagnosticsViewModel}"><views:EngineeringDiagnosticsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:EngineeringDevicesViewModel}"><views:EngineeringDevicesView /></DataTemplate>
        <HierarchicalDataTemplate x:Key="NavigationItemTemplate"
                                  ItemsSource="{Binding Children}"
                                  ItemContainerStyle="{StaticResource NavigationTreeViewItemStyle}">
            <Button Content="{Binding Title}"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource NavigationItemButtonStyle}" />
        </HierarchicalDataTemplate>
    </Window.Resources>
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="22,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left"
                           Text="SCADA TEMPLATE"
                           VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="White" />
                <TextBlock Text="{Binding CurrentWorkspaceTitle}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource HeaderMutedBrush}" />
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource NavigationBrush}" Padding="12,16">
                <TreeView ItemsSource="{Binding NavigationItems}"
                          ItemTemplate="{StaticResource NavigationItemTemplate}"
                          ItemContainerStyle="{StaticResource NavigationTreeViewItemStyle}"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="White"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                </TreeView>
            </Border>
            <Border Grid.Column="1" Padding="28" Background="{StaticResource WindowBrush}">
                <ContentControl Content="{Binding CurrentViewModel}" />
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource StatusBrush}" Padding="12,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding RuntimeStatusText}"
                           Foreground="{StaticResource HeaderMutedBrush}"
                           FontSize="11" />
                <TextBlock Text="  •  " Foreground="{StaticResource HeaderMutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding PlcHealthIndicatorText}"
                           AutomationProperties.Name="{Binding PlcHealthAutomationName}"
                           Foreground="{StaticResource HeaderMutedBrush}"
                           FontSize="11" />
                <TextBlock Text="  •  " Foreground="{StaticResource HeaderMutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding HistoryHealthIndicatorText}"
                           AutomationProperties.Name="{Binding HistoryHealthAutomationName}"
                           Foreground="{StaticResource HeaderMutedBrush}"
                           FontSize="11" />
                <TextBlock Text="  •  " Foreground="{StaticResource HeaderMutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding MqttHealthIndicatorText}"
                           AutomationProperties.Name="{Binding MqttHealthAutomationName}"
                           Foreground="{StaticResource HeaderMutedBrush}"
                           FontSize="11" />
                <TextBlock Text="  •  " Foreground="{StaticResource HeaderMutedBrush}" FontSize="11" />
                <TextBlock Text="{Binding RuntimeHealthIndicatorText}"
                           AutomationProperties.Name="{Binding RuntimeHealthAutomationName}"
                           Foreground="{StaticResource HeaderMutedBrush}"
                           FontSize="11" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
